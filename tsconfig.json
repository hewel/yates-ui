{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "gnim/gtk4",
    "lib": ["ES2024"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "paths": {},
    "strict": true,
    "target": "ES2020"
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "./@girs/**/*.d.ts"],
  "exclude": ["dist", "node_modules"]
}
