{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "gnim/gtk4",
    "lib": [
      "ES2023"
    ],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "paths": {},
    "strict": true,
    "target": "ES2020"
  },
  "exclude": [
    "dist",
    "node_modules"
  ]
}
